# Local Python venv used by the schema validation harness.
# Recreate locally with:
#   python3 -m venv .schema-venv
#   .schema-venv/bin/pip install jsonschema pyyaml
.schema-venv/

# Python byte-code that might end up under schemas/.validation/ during dev.
__pycache__/
*.pyc
*.pyo

# macOS clutter.
.DS_Store

# Generated document exports; keep the Markdown sources tracked.
docs/spack-learnings/*.docx
docs/spack-learnings/*.pdf

# Local working drafts and generated handoff exports.
drafts/
output/pdf/
